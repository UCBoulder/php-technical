{
  "name": "PHP Technical Assessment",
  "image": "mcr.microsoft.com/devcontainers/php:4-8.3-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "22"
    }
  },

  "secrets": {
    "CODEX_AUTH_JSON": {
      "description": "Contents of your personal ~/.codex/auth.json file. Treat this value like a password.",
      "documentationUrl": "https://developers.openai.com/codex/auth#login-on-headless-devices"
    }
  },

  "remoteEnv": {
    "PATH": "/workspaces/${localWorkspaceFolderBasename}/.devcontainer/node_modules/.bin:${containerEnv:PATH}",
    "XDEBUG_MODE": "develop"
  },

  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  },

  "onCreateCommand": "npm ci --prefix .devcontainer",
  "postCreateCommand": {
    "codexAuth": ".devcontainer/setup-codex-auth.sh",
    "tests": "make test-local"
  },
  "waitFor": "postCreateCommand",

  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "xdebug.php-debug"
      ],
      "settings": {
        "git.openRepositoryInParentFolders": "always"
      }
    }
  }
}
